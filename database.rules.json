{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "newData.hasChild('meta')",
        "meta": {
          ".validate": "newData.hasChildren(['v', 'created', 'status'])"
        },
        "seats": {
          "$i": {
            ".validate": "newData.hasChildren(['cid', 'name', 'token', 'color']) && newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "presence": {
          "$cid": {
            ".validate": "newData.isBoolean() && $cid.length <= 40"
          }
        },
        "state": {
          ".validate": "newData.hasChildren(['players', 'tiles', 'phase'])"
        },
        "chat": {
          "$msg": {
            ".validate": "newData.hasChildren(['cid', 'name', 'text']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
